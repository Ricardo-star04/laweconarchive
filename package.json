{
  "name": "law-and-economics-academic-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "covers": "node scripts/generate-publication-covers.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "security:static": "node scripts/security-check.mjs",
    "security:deps": "npm audit --omit=dev --audit-level=high",
    "security:release": "node scripts/security-check.mjs --release && npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "next": "^16.2.12",
    "next-mdx-remote": "^6.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "reading-time": "^1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.2",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.8.0",
    "eslint-config-next": "^16.2.12",
    "postcss": "^8.5.24",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "minimatch": "10.2.6",
    "postcss": "$postcss",
    "sharp": "0.35.3"
  }
}
